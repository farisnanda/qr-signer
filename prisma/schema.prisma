generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  password         String?
  role             String   @default("BIDANG")
  bidang           String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
}

/// Peserta pengambilan sumpah — self-service. Diimport admin (NIP/Nama/Pangkat/
/// Perangkat Daerah/Agama), lalu peserta aktivasi sendiri: isi email+password,
/// verifikasi lewat email. emailVerified = gerbang boleh login.
model Peserta {
  id              String        @id @default(cuid())
  nip             String        @unique
  nama            String
  pangkat         String
  perangkatDaerah String
  agama           String
  email           String?       @unique
  password        String?
  emailVerified   Boolean       @default(false)
  verifyToken     String?       @unique
  verifyExpires   DateTime?
  resetToken      String?       @unique
  resetExpires    DateTime?
  signatureKey    String? // object Minio TTD (Fase 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  koreksi         KoreksiData[]

  @@index([emailVerified, createdAt])
  @@index([perangkatDaerah])
  @@index([createdAt])
}

/// Permintaan koreksi data peserta (nama/gelar, agama, pangkat, perangkat
/// daerah). Peserta ajukan -> admin memutuskan (terima/tolak) -> peserta
/// diberi tahu via email. Diterima = field terkait di Peserta diperbarui.
model KoreksiData {
  id           String    @id @default(cuid())
  pesertaNip   String
  peserta      Peserta   @relation(fields: [pesertaNip], references: [nip], onDelete: Cascade)
  field        String // "nama" | "agama" | "pangkat" | "perangkatDaerah"
  nilaiLama    String
  nilaiDiminta String
  alasan       String?
  status       String    @default("pending") // pending | approved | rejected
  catatanAdmin String?
  diprosesOleh String?
  diprosesAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([pesertaNip, createdAt])
}

/// Sesi pengambilan sumpah dgn PIN. Panitia buat sesi + PIN, dibagikan ke
/// peserta yg hadir fisik. PIN = gerbang absensi saat generate dokumen.
model Sesi {
  id        String      @id @default(cuid())
  nama      String
  pin       String
  pinHash   String?     @unique
  aktif     Boolean     @default(true)
  createdBy String
  createdAt DateTime    @default(now())
  kehadiran Kehadiran[]

  @@index([aktif, createdAt])
  @@index([pin, aktif])
  @@index([pinHash, aktif])
}

/// Catatan kehadiran: peserta yg sudah absen (via PIN) & generate dokumen.
model Kehadiran {
  id          String   @id @default(cuid())
  sesiId      String
  sesi        Sesi     @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  pesertaNip  String
  pesertaNama String
  dokumenKey  String?
  checkedInAt DateTime @default(now())

  @@unique([sesiId, pesertaNip])
  @@index([pesertaNip])
  @@index([checkedInAt])
}

model SignBatch {
  id             String    @id @default(cuid())
  batchCode      String    @unique
  jenisSk        String
  total          Int
  successCount   Int
  errorCount     Int
  zipFileName    String?
  reportFileName String?
  signedBy       String
  createdAt      DateTime  @default(now())
  logs           SignLog[]

  @@index([signedBy, createdAt])
  @@index([jenisSk, createdAt])
}

model SignLog {
  id           String    @id @default(cuid())
  batchId      String
  batch        SignBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  jenisSk      String
  namaFile     String?
  nip          String?
  nama         String?
  status       String
  errorMessage String?
  signedBy     String
  signedAt     DateTime  @default(now())

  @@index([batchId, signedAt])
  @@index([signedBy, signedAt])
  @@index([status, signedAt])
  @@index([nip])
}

model Document {
  id           String    @id @default(cuid())
  title        String
  documentNo   String
  filePath     String
  verifyToken  String    @unique
  qrX          Float?
  qrY          Float?
  qrWidth      Float?
  qrHeight     Float?
  documentDate DateTime?
  createdAt    DateTime  @default(now())
}
